ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=

# postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ghostwriter
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# optional ngrok proxy (dev only)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# prod only (docker-compose.prod.yml): the box's Tailscale IP, so the Mac's push job can
# reach Postgres over Tailscale without exposing 5432 publicly.
POSTGRES_BIND=127.0.0.1
